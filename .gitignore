# Ignore target directory (build artifacts)
target/
logs/
results/

# Ignore backup and temp files
**/*.rs.bk
**/*~
**/#*#
**/.#*

# By Cargo: https://github.com/github/gitignore/blob/main/Rust.gitignore
/target
**/*.rs.bk
# Cargo.lock is tracked: the exact dependency versions tmr.exe is built with. The research crates
# keep theirs out.
research/**/Cargo.lock

# Ignore patch files
*patch*.txt
*.patch
*.bak
/.claude
/.codex
# Local tool configs: an MCP server's path on one machine
.mcp.json
__pycache__/
CLAUDE.md
AGENTS.md
/temp_backup

# Generated by --create-demo-configs
demo_*.json
# What TMR keeps in its home (TODO 104) when TMR_HOME is the repo: logs/ and results/ are above
/configs/
/tmr-cfg.json
/colours.json

